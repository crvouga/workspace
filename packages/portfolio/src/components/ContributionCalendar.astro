---
import ContributionHeatmap from './ContributionHeatmap.astro';
import { MAX_RANGE_WINDOWS } from '../lib/github-ranges';
import type { ContributionRange } from '../lib/github';

interface Props {
  ranges: readonly ContributionRange[];
}
const { ranges } = Astro.props;

if (ranges.length === 0) {
  throw new Error('ContributionCalendar requires at least one range');
}
// The panel-switching CSS below enumerates one rule per index; more periods than
// it covers would silently render a blank card.
if (ranges.length > MAX_RANGE_WINDOWS) {
  throw new Error(
    `ContributionCalendar supports at most ${String(MAX_RANGE_WINDOWS)} ranges, got ${String(ranges.length)}`
  );
}

const count = (value: number): string => value.toLocaleString('en-US');
const inputId = (id: string): string => `gh-range-${id}`;
const LEVEL_CLASSES = ['c0', 'c1', 'c2', 'c3', 'c4'];
---

<div class="gh-calendar">
  <p class="visually-hidden" id="gh-range-legend">Contribution period</p>
  {
    ranges.map((range, index) => (
      <Fragment>
        <input
          class="gh-radio"
          type="radio"
          name="gh-range"
          id={inputId(range.id)}
          value={range.id}
          checked={index === 0}
        />
        <label class="range-option" for={inputId(range.id)}>
          {range.label}
        </label>
      </Fragment>
    ))
  }

  <div class="panels">
    {
      ranges.map((range) => (
        <div class="panel" data-range={range.id}>
          <p class="panel-total">
            <strong>{count(range.totalContributions)}</strong> contributions
            <span class="panel-window">{`${range.from} → ${range.to}`}</span>
          </p>
          <ContributionHeatmap range={range} />
          <p class="panel-meta">
            {`${count(range.activeDays)} active days · longest streak ${count(range.longestStreak)} days · busiest day ${count(range.busiestCount)}`}
          </p>
        </div>
      ))
    }
  </div>

  <div class="legend" aria-hidden="true">
    <span>Less</span>
    {LEVEL_CLASSES.map((level) => <span class={`swatch ${level}`} />)}
    <span>More</span>
  </div>
</div>

<style>
  .gh-calendar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  /* Focusable but invisible: the labels are the visible control surface. */
  .gh-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .range-option {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    user-select: none;
    transition:
      border-color var(--motion-fast) var(--motion-ease),
      background var(--motion-fast) var(--motion-ease),
      color var(--motion-fast) var(--motion-ease);
  }

  .range-option:hover {
    border-color: var(--paper-border-hover);
    color: var(--text);
  }

  .gh-radio:checked + .range-option {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .gh-radio:focus-visible + .range-option {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .panels {
    flex: 1 0 100%;
    /* Without this a flex item's automatic minimum size is the grid's full
       intrinsic width, so the card overflows its container on phones and the
       heatmap never scrolls. */
    min-width: 0;
    margin-top: var(--space-4);
  }

  /* Pure-CSS panel switching: the checked radio's index selects its panel, so
     the picker works with JavaScript disabled. Index rules are enumerated up to
     MAX_RANGE_WINDOWS (8), which the frontmatter asserts against. */
  .panel {
    display: none;
  }
  .gh-radio:nth-of-type(1):checked ~ .panels > .panel:nth-child(1),
  .gh-radio:nth-of-type(2):checked ~ .panels > .panel:nth-child(2),
  .gh-radio:nth-of-type(3):checked ~ .panels > .panel:nth-child(3),
  .gh-radio:nth-of-type(4):checked ~ .panels > .panel:nth-child(4),
  .gh-radio:nth-of-type(5):checked ~ .panels > .panel:nth-child(5),
  .gh-radio:nth-of-type(6):checked ~ .panels > .panel:nth-child(6),
  .gh-radio:nth-of-type(7):checked ~ .panels > .panel:nth-child(7),
  .gh-radio:nth-of-type(8):checked ~ .panels > .panel:nth-child(8) {
    display: block;
  }

  .panel-total {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }
  .panel-total strong {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text);
  }
  .panel-window {
    margin-left: auto;
    font-size: 11px;
    color: var(--text-subtle);
  }
  .panel-meta {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-subtle);
  }

  .legend {
    flex: 1 0 100%;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-subtle);
    margin-top: var(--space-2);
  }
  .swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    display: inline-block;
  }
  .swatch.c0 {
    background: var(--gh-0);
  }
  .swatch.c1 {
    background: var(--gh-1);
  }
  .swatch.c2 {
    background: var(--gh-2);
  }
  .swatch.c3 {
    background: var(--gh-3);
  }
  .swatch.c4 {
    background: var(--gh-4);
  }

  @media (max-width: 599px) {
    .panel-window {
      margin-left: 0;
      flex-basis: 100%;
    }
    .legend {
      justify-content: flex-start;
    }
  }
</style>

<script is:inline>
  // Progressive enhancement only: the CSS above already switches panels. This
  // parks each grid at its most recent week, which is the part people look at.
  document.addEventListener('DOMContentLoaded', () => {
    const scrollToLatest = (panel) => {
      const scroller = panel.querySelector('[data-heatmap-scroll]');
      if (scroller) scroller.scrollLeft = scroller.scrollWidth;
    };
    document.querySelectorAll('.gh-calendar').forEach((calendar) => {
      calendar.querySelectorAll('.panel').forEach(scrollToLatest);
      calendar.querySelectorAll('.gh-radio').forEach((radio, index) => {
        radio.addEventListener('change', () => {
          const panel = calendar.querySelectorAll('.panel')[index];
          if (panel) scrollToLatest(panel);
        });
      });
    });
  });
</script>
