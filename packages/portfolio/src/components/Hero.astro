---
import { CONTENT } from '../content/content';
import { RESUME_HREF } from '../constants/resume';
import { VISIBLE_PROJECTS } from '../lib/projects-view';

const email = CONTENT.EMAIL_ADDRESS;
const lead = VISIBLE_PROJECTS[0];
if (lead === undefined) {
  throw new Error('The homepage registry has no lead project.');
}
const plain = lead.description.replace(/<[^>]*>/g, '');
const period = plain.indexOf('. ');
const sentence = period === -1 ? plain : plain.slice(0, period + 1);
const cover = lead.imageSrc[0];
---

<section id="top" class="plate">
  {
    cover === undefined ? (
      <p class="shot-fallback">{lead.title}</p>
    ) : (
      <button type="button" class="gallery-btn shot" data-gallery="0">
        <img
          src={cover}
          alt={lead.imageAlt}
          width="1400"
          height="788"
          decoding="async"
        />
        <span class="visually-hidden">Open {lead.title} images</span>
      </button>
    )
  }
  <div class="rail">
    <p class="mark">{CONTENT.MONOGRAM_INITIALS}</p>
    <h1>{lead.title}</h1>
    <p class="who">
      {CONTENT.HERO.name} · {CONTENT.LOCATION}
    </p>
    <p class="sentence">{sentence}</p>
    <p class="reach">
      <a class="inline-link" href={`mailto:${email}`}>{email}</a>
      <button type="button" class="copy-btn" data-copy={email}>
        <span class="btn-label">{CONTENT.HERO.ctaCopyLabel}</span>
      </button>
      <a href={RESUME_HREF} target="_blank" rel="noopener">Résumé</a>
    </p>
  </div>
</section>
<section class="pitch">
  <div class="container">
    <p>{CONTENT.HERO.statement}</p>
    <p>{CONTENT.HERO.statementSecondary}</p>
    <p class="avail">{CONTENT.HERO.availability}</p>
  </div>
</section>

<style>
  .plate {
    display: grid;
    grid-template-columns: 1fr;
    min-height: calc(100svh - 7.5rem);
    background: var(--bg);
  }
  .shot,
  .shot-fallback {
    min-height: 52svh;
    background: var(--bg);
  }
  button.shot {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    color: inherit;
  }
  .shot img {
    width: 100%;
    height: 100%;
    min-height: 52svh;
    object-fit: cover;
  }
  .shot-fallback {
    display: grid;
    place-items: center;
    padding: var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .rail {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5);
    border-top: 2px solid var(--accent);
  }
  .mark {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.03em;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5vw, 5.5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .who {
    color: var(--text-muted);
    font-size: var(--text-lg);
  }
  .sentence {
    max-width: 42ch;
    color: var(--text);
    font-size: var(--text-md);
  }
  .reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .reach a,
  .copy-btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .copy-btn {
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--accent);
    cursor: pointer;
  }
  .copy-btn:hover {
    color: var(--accent-hover);
  }
  .pitch {
    padding-block: var(--space-8);
  }
  .pitch p {
    max-width: 68ch;
    color: var(--text-muted);
  }
  .pitch p + p {
    margin-top: var(--space-4);
  }
  .avail {
    color: var(--text);
  }
  @media (min-width: 900px) {
    .plate {
      grid-template-columns: 1.35fr 0.65fr;
      min-height: calc(100svh - 4.5rem);
    }
    .shot,
    .shot img,
    .shot-fallback {
      min-height: 100%;
      height: 100%;
    }
    .rail {
      justify-content: center;
      border-top: 0;
      border-left: 2px solid var(--accent);
      padding: var(--space-7);
    }
  }
</style>
