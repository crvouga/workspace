---
import { CONTENT } from '../content/content';
import IconEmail from '../components/icons/IconEmail.astro';
import IconDownload from '../components/icons/IconDownload.astro';
import IconGitHub from '../components/icons/IconGitHub.astro';
import IconLinkedIn from '../components/icons/IconLinkedIn.astro';

const email = CONTENT.EMAIL_ADDRESS;
---

<section id="top" class="hero">
  <div class="container">
    <p class="eyebrow">// full-stack software engineer · phoenix, az</p>
    <h1>Chris Vouga</h1>
    <p class="statement">
      I build and ship production software end-to-end — APIs, infrastructure,
      and interfaces — with an AI-native, agentic workflow.
    </p>
    <p class="pill"><span class="dot" aria-hidden="true"></span>Open to work</p>
    <div class="ctas">
      <a class="btn btn-contained" href={`mailto:${email}`} data-copy={email}>
        <IconEmail />Email
      </a>
      <a class="btn" href="/chris-vouga-resume.pdf" download>
        <IconDownload />Résumé
      </a>
      <a class="btn" href={CONTENT.GITHUB_URL} rel="me noopener" target="_blank">
        <IconGitHub />GitHub
      </a>
      <a class="btn" href={CONTENT.LINKEDIN_URL} rel="me noopener" target="_blank">
        <IconLinkedIn />LinkedIn
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 96px 64px;
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: 140px 80px;
    }
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    margin-bottom: 16px;
  }
  h1 {
    font-family: var(--font-mono);
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .statement {
    max-width: 560px;
    font-size: 18px;
    color: var(--text-muted);
    margin-top: 20px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    padding: 6px 12px;
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-pill);
    margin-top: 24px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>

<script is:inline define:vars={{ email }}>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-copy]').forEach((el) => {
      el.addEventListener('click', (event) => {
        event.preventDefault();
        navigator.clipboard.writeText(email).catch(() => {
          window.location.href = 'mailto:' + email;
        });
      });
    });
  });
</script>