---
import { CONTENT } from '../content/content';
import { TOPIC_TO_NAME } from '../content/topic';
import IconEmail from '../components/icons/IconEmail.astro';
import IconDownload from '../components/icons/IconDownload.astro';
import IconGitHub from '../components/icons/IconGitHub.astro';
import IconLinkedIn from '../components/icons/IconLinkedIn.astro';

const email = CONTENT.EMAIL_ADDRESS;
const currentJob = CONTENT.WORK.find((job) => job.yearEnd === 'Present');
const nowRole =
  currentJob === undefined ? '' : `${currentJob.jobTitle} · ${currentJob.name}`;
const sinceYear = CONTENT.WORK.reduce(
  (earliest, job) => Math.min(earliest, job.yearStart),
  new Date().getFullYear()
);
const stack = CONTENT.CORE_STACK.map((topic) => TOPIC_TO_NAME[topic]).join(' · ');
---

<section id="top" class="hero">
  <div class="container hero-grid">
    <div class="intro">
      <p class="eyebrow">{CONTENT.HERO.eyebrow}</p>
      <h1>{CONTENT.HERO.name}</h1>
      <p class="statement">{CONTENT.HERO.statement}</p>
      <p class="pill">
        <span class="dot" aria-hidden="true"></span>{CONTENT.HERO.availability}
      </p>
      <div class="ctas">
        <a class="btn btn-contained" href={`mailto:${email}`} data-copy={email}>
          <IconEmail /><span class="btn-label">{CONTENT.HERO.ctaPrimary.label}</span>
        </a>
        <a class="btn" href="/chris-vouga-resume.pdf" download>
          <IconDownload /><span class="btn-label">Résumé</span>
        </a>
        <a class="btn" href={CONTENT.GITHUB_URL} rel="me noopener" target="_blank">
          <IconGitHub /><span class="btn-label">GitHub</span>
        </a>
        <a
          class="btn"
          href={CONTENT.LINKEDIN_URL}
          rel="me noopener"
          target="_blank"
        >
          <IconLinkedIn /><span class="btn-label">LinkedIn</span>
        </a>
      </div>
    </div>

    <aside class="card now">
      <p class="now-label">// currently</p>
      <h2 class="now-role">{nowRole}</h2>
      <p class="now-since">Shipping production software since {sinceYear}</p>
      <p class="now-loc">{CONTENT.LOCATION}</p>
      <p class="now-stack">{stack}</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: 140px var(--space-8);
    }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(280px, 1fr);
    }
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    margin-bottom: var(--space-4);
  }
  h1 {
    font-family: var(--font-mono);
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .statement {
    max-width: 560px;
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-top: var(--space-5);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    padding: 6px var(--space-3);
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-pill);
    margin-top: var(--space-5);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .now {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .now-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
  .now-role {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
  }
  .now-since,
  .now-loc {
    font-size: var(--text-base);
    color: var(--text-muted);
  }
  .now-stack {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--paper-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }
</style>
