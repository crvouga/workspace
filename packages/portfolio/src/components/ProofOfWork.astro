---
import { CONTENT } from '../content/content';
import {
  GitHubInsightsError,
  fetchGitHubInsights,
  type GitHubInsights,
} from '../lib/github';
import ContributionHeatmap from './ContributionHeatmap.astro';

// Strict in production: a missing credential or unusable GitHub response aborts
// the build with an actionable error (see lib/github.ts) rather than rendering a
// blank map. `astro dev` degrades to a notice card instead, so the page stays
// workable without Vault or a local .env token.
const envToken = import.meta.env.PORTFOLIO_GITHUB_TOKEN;

let insights: GitHubInsights | null = null;
try {
  insights = await fetchGitHubInsights(
    'crvouga',
    envToken ? { token: envToken } : {}
  );
} catch (error) {
  if (!import.meta.env.DEV || !(error instanceof GitHubInsightsError)) {
    throw error;
  }
  console.warn(`[portfolio] ${error.message}`);
}

const section = CONTENT.GET_SECTION('proof');
const fetchedDate = insights === null ? '' : insights.fetchedAt.slice(0, 10);
const totals = insights === null ? '' : insights.totalContributions.toLocaleString('en-US');

const tiles =
  insights === null
    ? []
    : [
        { value: totals, label: 'Contributions (12mo)' },
        { value: String(insights.longestStreak), label: 'Longest streak (days)' },
        { value: String(insights.currentStreak), label: 'Current streak (days)' },
        { value: String(insights.publicRepos), label: 'Public repos' },
        { value: String(insights.followers), label: 'Followers' },
      ];
---

<section id="proof">
  <div class="container">
    <div class="section-heading">
      <span class="number">{section.number}</span>
      <h2>{section.title}</h2>
    </div>
    {
      insights === null ? (
        <div class="card heatmap-card">
          <p>
            GitHub proof data unavailable in dev. Set <code>PORTFOLIO_GITHUB_TOKEN</code> in
            packages/portfolio/.env, or run via <code>bun portfolio</code>.
          </p>
        </div>
      ) : (
        <>
          <div class="card heatmap-card">
            <ContributionHeatmap calendar={insights.calendar} />
            <div class="legend" aria-hidden="true">
              <span>Less</span>
              {['c0', 'c1', 'c2', 'c3', 'c4'].map((c) => (
                <span class={`swatch ${c}`} />
              ))}
              <span>More</span>
            </div>
            <p class="visually-hidden">
              {CONTENT.ABOUT_GITHUB_HEATMAP_TEXT} {totals} contributions in the last 12 months.
            </p>
          </div>
          <div class="tiles">
            {tiles.map((tile) => (
              <div class="card tile">
                <span class="value">{tile.value}</span>
                <span class="label">{tile.label}</span>
              </div>
            ))}
          </div>
          <p class="caption">
            {`Live data fetched from the GitHub API at build time · ${fetchedDate} · `}
            <a href={CONTENT.GITHUB_URL} rel="me noopener" target="_blank">
              verify on GitHub
            </a>
          </p>
        </>
      )
    }
  </div>
</section>

<style>
  .heatmap-card {
    padding: var(--space-5);
  }
  .heatmap-card :global(svg.heatmap) {
    max-width: 100%;
  }
  .heatmap-card p {
    color: var(--text-muted);
    font-size: var(--text-base);
  }
  .heatmap-card code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }
  .legend {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-subtle);
    margin-top: var(--space-3);
  }
  .swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    display: inline-block;
  }
  .swatch.c0 {
    background: var(--gh-0);
  }
  .swatch.c1 {
    background: var(--gh-1);
  }
  .swatch.c2 {
    background: var(--gh-2);
  }
  .swatch.c3 {
    background: var(--gh-3);
  }
  .swatch.c4 {
    background: var(--gh-4);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .tile {
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .tile .value {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--accent);
  }
  .tile .label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .caption {
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
</style>
