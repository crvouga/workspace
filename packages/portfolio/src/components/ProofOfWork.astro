---
import { CONTENT } from '../content/content';
import { fetchGitHubInsights } from '../lib/github';
import ContributionHeatmap from './ContributionHeatmap.astro';

const insights = await fetchGitHubInsights('crvouga');

// No data at all (GitHub unreachable at build): omit the section entirely.
const hasCalendar = insights !== null && insights.calendar.length > 0;
const hasCounts = insights !== null;

const tiles = insights
  ? [
      ...(hasCalendar
        ? [
            { value: String(insights.totalContributions), label: 'contributions · last 12 months' },
            { value: String(insights.longestStreak), label: 'longest streak (days)' },
            { value: String(insights.currentStreak), label: 'current streak (days)' },
          ]
        : []),
      ...(insights.publicRepos > 0
        ? [{ value: String(insights.publicRepos), label: 'public repos' }]
        : []),
      ...(insights.followers > 0
        ? [{ value: String(insights.followers), label: 'followers' }]
        : []),
    ]
  : [];
---

{
  hasCounts && (
    <section id="proof">
      <div class="container">
        <div class="section-heading">
          <span class="number">//</span>
          <h2>Proof, not promises</h2>
        </div>
        {hasCalendar && (
          <div class="card heatmap-card">
            <ContributionHeatmap calendar={insights.calendar} />
            <div class="legend" aria-hidden="true">
              <span>Less</span>
              {['c0', 'c1', 'c2', 'c3', 'c4'].map((c) => (
                <span class={`swatch ${c}`} />
              ))}
              <span>More</span>
            </div>
          </div>
        )}
        <div class="tiles">
          {tiles.map((tile) => (
            <div class="card tile">
              <span class="value">{tile.value}</span>
              <span class="label">{tile.label}</span>
            </div>
          ))}
        </div>
        <p class="caption">
          Live data fetched from the GitHub API at build time ·{' '}
          <a href={CONTENT.GITHUB_URL} rel="me noopener" target="_blank">
            verify on GitHub
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .heatmap-card {
    padding: 24px;
    overflow-x: auto;
  }
  .heatmap-card :global(svg.heatmap) {
    max-width: 100%;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 4px;
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-subtle);
    margin-top: 12px;
  }
  .swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    display: inline-block;
  }
  .swatch.c0 {
    background: var(--gh-0);
  }
  .swatch.c1 {
    background: var(--gh-1);
  }
  .swatch.c2 {
    background: var(--gh-2);
  }
  .swatch.c3 {
    background: var(--gh-3);
  }
  .swatch.c4 {
    background: var(--gh-4);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin-top: 24px;
  }
  .tile {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tile .value {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 700;
    color: var(--accent);
  }
  .tile .label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  .caption {
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-subtle);
  }
</style>