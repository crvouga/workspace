---
import { CONTENT } from '../content/content';
import type { Work } from '../content/work';

const section = CONTENT.GET_SECTION('work');
const years = (job: Work): string =>
  `${job.yearStart}\u2013${job.yearEnd === 'Present' ? 'Present' : job.yearEnd}`;
---

<section id="work">
  <div class="container">
    <div class="section-heading">
      <span class="number">{section.number}</span>
      <h2>{section.title}</h2>
    </div>
    <div class="jobs">
      {
        CONTENT.WORK.map((job) => (
          <article class={`card job ${job.imageSrc[0] === undefined ? 'no-media' : ''}`}>
            {job.imageSrc[0] !== undefined && (
              <div class="media">
                <img
                  src={job.imageSrc[0]}
                  alt={job.imageAlt}
                  loading="lazy"
                  decoding="async"
                  width="1400"
                  height="788"
                />
              </div>
            )}
            <div class="body">
              <div class="head">
                <h3>
                  {job.infoUrl ? (
                    <a href={job.infoUrl} rel="noopener" target="_blank">
                      {job.name}
                    </a>
                  ) : (
                    job.name
                  )}
                </h3>
                <span class="years">{years(job)}</span>
              </div>
              <p class="role">{job.jobTitle}</p>
              <ul class="highlights">
                {job.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .jobs {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .job {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
  }
  .job.no-media {
    display: block;
  }
  .job.no-media .body {
    max-width: 760px;
  }
  @media (min-width: 900px) {
    .job {
      grid-template-columns: 340px 1fr;
    }
  }
  .media {
    align-self: stretch;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the top of each site screenshot (its nav/hero) inside the crop. */
    object-position: top center;
  }
  .body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .years {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }
  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .role {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
  }
  .highlights {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .highlights li {
    position: relative;
    padding-left: 20px;
    color: var(--text-muted);
    font-size: var(--text-base);
  }
  .highlights li::before {
    content: '\203A';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }
</style>
