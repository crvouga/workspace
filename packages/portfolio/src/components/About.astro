---
import { CONTENT } from '../content/content';

const section = CONTENT.GET_SECTION('about');
---

<section id="about">
  <div class="container">
    <div class="section-heading">
      <span class="number">{section.number}</span>
      <h2>{section.title}</h2>
    </div>
    <div class="prose" set:html={CONTENT.ABOUT_ME} />
    <div class="toolbox">
      <h3 class="toolbox-title">Toolbox</h3>
      {
        CONTENT.SKILL_ROWS.map((row) => (
          <div class="tool-row">
            <span class="tool-cat">{row.category}</span>
            <span class="tool-items">{row.items.join(' · ')}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .prose {
    max-width: 68ch;
    color: var(--text-muted);
    font-size: var(--text-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    white-space: pre-line;
  }
  .toolbox {
    margin-top: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .toolbox-title {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .tool-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: 1px solid var(--paper-border);
  }
  @media (min-width: 900px) {
    .tool-row {
      grid-template-columns: 140px 1fr;
      gap: var(--space-4);
      align-items: baseline;
    }
  }
  .tool-cat {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }
  .tool-items {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
