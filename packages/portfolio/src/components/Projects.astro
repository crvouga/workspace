---
import { CONTENT } from '../content/content';
import { TOPIC_TO_IMAGE_SRC, TOPIC_TO_NAME } from '../content/topic';
import type { Project } from '../content/project';
import {
  COLLAPSED_PROJECTS,
  VISIBLE_PROJECTS,
  galleryFor,
  projectHref,
} from '../lib/projects-view';

const section = CONTENT.GET_SECTION('projects');
const MAX_CHIPS = 6;

const chipsFor = (project: Project): string[] => project.topics.slice(0, MAX_CHIPS);
const extraTopicCount = (project: Project): number =>
  Math.max(0, project.topics.length - MAX_CHIPS);
---

<section id="projects">
  <div class="container">
    <div class="section-heading">
      <span class="number">{section.number}</span>
      <h2>{section.title}</h2>
    </div>
    <div class="grid">
      {
        VISIBLE_PROJECTS.map((project, index) => (
          <article class="card project">
            {project.imageSrc[0] !== undefined && (
              <div class="cover-box">
                <img
                  class="cover"
                  src={project.imageSrc[0]}
                  alt={project.imageAlt}
                  loading="lazy"
                  decoding="async"
                  width="1400"
                  height="788"
                />
              </div>
            )}
            <div class="body">
              <h3>
                <a href={projectHref(project)} rel="noopener" target="_blank">
                  {project.title}
                </a>
              </h3>
              <p class="desc" set:html={project.description} />
              <div class="meta">
                <div class="chips">
                  {chipsFor(project).map((topic) => (
                    <span class="chip">
                      {TOPIC_TO_IMAGE_SRC[topic] && (
                        <img
                          src={TOPIC_TO_IMAGE_SRC[topic] ?? ''}
                          alt=""
                          loading="lazy"
                        />
                      )}
                      {TOPIC_TO_NAME[topic]}
                    </span>
                  ))}
                  {extraTopicCount(project) > 0 && (
                    <span class="chip chip-more">+{extraTopicCount(project)}</span>
                  )}
                </div>
                <div class="links">
                  {project.deployment.t === 'public' && (
                    <a href={project.deployment.url} rel="noopener" target="_blank">
                      Live
                    </a>
                  )}
                  {project.code.t === 'public' && (
                    <a href={project.code.url} rel="noopener" target="_blank">
                      Code
                    </a>
                  )}
                  {galleryFor(project).length > 0 && (
                    <button
                      type="button"
                      class="gallery-btn"
                      data-gallery={index}
                    >
                      Images
                    </button>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
    {
      COLLAPSED_PROJECTS.length > 0 && (
        <details class="more">
          <summary>Show {COLLAPSED_PROJECTS.length} more projects</summary>
          <div class="grid more-grid">
            {COLLAPSED_PROJECTS.map((project) => (
              <article class="card project compact">
                <div class="body">
                  <h3>
                    <a href={projectHref(project)} rel="noopener" target="_blank">
                      {project.title}
                    </a>
                  </h3>
                  <p class="desc" set:html={project.description} />
                  <div class="chips">
                    {chipsFor(project).map((topic) => (
                      <span class="chip">{TOPIC_TO_NAME[topic]}</span>
                    ))}
                  </div>
                  <div class="links">
                    {project.deployment.t === 'public' && (
                      <a
                        href={project.deployment.url}
                        rel="noopener"
                        target="_blank"
                      >
                        Live
                      </a>
                    )}
                    {project.code.t === 'public' && (
                      <a href={project.code.url} rel="noopener" target="_blank">
                        Code
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </details>
      )
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  /* Fixed aspect keeps every row aligned regardless of the source ratio. */
  .cover-box {
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--paper-border);
    background: var(--bg);
  }
  .project .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }
  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  h3 a {
    color: var(--text);
  }
  h3 a:hover {
    color: var(--accent);
  }
  .desc {
    color: var(--text-muted);
    font-size: var(--text-base);
    flex: 1;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip-more {
    color: var(--text-subtle);
  }
  .meta {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .links a,
  .gallery-btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--accent);
  }
  .gallery-btn {
    background: none;
    border: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .gallery-btn:hover {
    color: #a6cbff;
  }
  .more {
    margin-top: var(--space-5);
  }
  .more summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    cursor: pointer;
    padding: var(--space-2) 0;
  }
  .more-grid {
    margin-top: var(--space-4);
  }
</style>
