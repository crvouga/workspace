---
import { CONTENT } from '../content/content';
import ProjectCard from './ProjectCard.astro';
import { LISTED_PROJECTS, VISIBLE_PROJECTS } from '../lib/projects-view';

const section = CONTENT.GET_SECTION('projects');
const archiveCount = LISTED_PROJECTS.length;
---

<section id="projects">
  <div class="container">
    <div class="section-heading">
      <h2>{section.title}</h2>
    </div>
    <div class="grid">
      {
        VISIBLE_PROJECTS.slice(1).map((project, index) => (
          <ProjectCard
            project={project}
            galleryIndex={index + 1}
          />
        ))
      }
    </div>
    <p class="archive">
      <a href="/projects/">Browse all {archiveCount} projects</a>
    </p>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  .archive {
    margin-top: var(--space-5);
  }
  .archive a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
  }
  .archive a:hover {
    color: var(--accent-hover);
  }
</style>
