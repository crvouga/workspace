---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Seo } from '../lib/seo-types';

interface Props {
  seo: Seo;
}
const { seo } = Astro.props;
---

<Base seo={seo}>
  <Nav variant="sub" />
  <main id="main">
    <slot />
  </main>
  <Footer />
</Base>
