{
  "$schema": "https://v2-10-13.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "tc": {
      "inputs": [
        "src/**",
        "projects.ts",
        "tsconfig.json",
        "astro.config.mjs",
        "package.json",
        "../../tsconfig.strict.json"
      ]
    },
    "lint": {
      "inputs": [
        "src/**",
        "scripts/**",
        "test/**",
        "projects.ts",
        "eslint.config.cjs",
        "astro.config.mjs",
        "package.json"
      ]
    },
    "test": {
      "inputs": ["src/**", "projects.ts", "public/**", "package.json"]
    },
    "build": {
      "inputs": [
        "src/**",
        "scripts/**",
        "projects.ts",
        "public/**",
        "package.json",
        "Dockerfile",
        "astro.config.mjs"
      ],
      "outputs": []
    }
  }
}
